   # Переменные окружения (САМОЕ ВАЖНОЕ!)
   .env
   .env.local
   .env.*.local

   # Виртуальное окружение Python
   .venv/
   venv/
   env/

   # Скомпилированные файлы Python
   __pycache__/
   *.py[cod]
   *$py.class

   # Файлы базы данных (на всякий случай)
   *.db
   *.sqlite3

   # Папки настроек редакторов кода
   .vscode/
   .idea/

   # Логи
   *.log